# Autohospedagem — contrato de variáveis do docker-compose.selfhost.yml.
#
# Copie para `.env` na raiz do repositório (é onde o Compose lê) e preencha.
# O jeito rápido, que já gera os segredos fortes por você:
#
#   ./scripts/gerar-env-autohospedagem.sh
#
# Só as quatro primeiras seções são obrigatórias. Todo o resto é opcional: em
# branco, o recurso correspondente se desativa sozinho.
# Guia completo: docs/autohospedagem.md

# =============================================================================
# 1. Domínio  (OBRIGATÓRIO)
# =============================================================================
# Host único: o front responde em / e a API em /api, mesma origem. O Caddy emite
# o certificado TLS para este nome, então o DNS dele precisa APONTAR PARA ESTA
# VPS (registro A) antes de subir o stack.
#
# Use um domínio de verdade. `localhost` funciona para experimentar na sua
# máquina (com aviso de certificado no navegador), mas endereço IP puro NÃO
# funciona: sem certificado válido o navegador recusa o cookie de sessão
# `Secure` e o login falha em silêncio.
#
# Ex.: CRM_DOMAIN=crm.suaempresa.com.br
CRM_DOMAIN=

# =============================================================================
# 2. TLS  (OBRIGATÓRIO)
# =============================================================================
# E-mail da conta Let's Encrypt: é para onde vai o aviso caso a renovação
# automática do certificado falhe. Não é publicado em lugar nenhum.
#
# Ex.: ACME_EMAIL=voce@suaempresa.com.br
ACME_EMAIL=

# =============================================================================
# 3. Banco de dados  (OBRIGATÓRIO)
# =============================================================================
# O Postgres sobe dentro do stack e não é exposto ao host. As connection strings
# são montadas pelo compose a partir daqui — não existe DATABASE_URL neste
# arquivo.
POSTGRES_USER=crm_user
POSTGRES_DB=crm_db
# Gere com: openssl rand -hex 32
POSTGRES_PASSWORD=

# Senha da role de aplicação `crm_app` (NOSUPERUSER/NOBYPASSRLS, sujeita ao Row
# Level Security). A migration cria essa role com uma senha de desenvolvimento
# que é PÚBLICA neste repositório; o entrypoint da API aplica a senha abaixo no
# banco a cada start. Sem ela a API aborta o boot de propósito.
#
# Gere com: openssl rand -hex 32
# Não pode conter apóstrofo (') nem barra invertida (\) — entra literal num
# ALTER ROLE e o entrypoint recusa esses caracteres.
APP_DB_PASSWORD=

# =============================================================================
# 4. JWT  (OBRIGATÓRIO)
# =============================================================================
# Mínimo de 32 caracteres cada, e valores DIFERENTES entre si.
# Gere cada um com: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Opcionais (defaults abaixo).
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# =============================================================================
# 5. Autocadastro
# =============================================================================
# true (default) permite criar conta em /registrar e criar conta nova via OAuth.
# MANTENHA true no primeiro boot: não há seed de admin em produção, e é em
# /registrar que a sua primeira conta nasce.
# Depois de criá-la, troque para false e rode `up -d` de novo — isso fecha as
# duas portas e o acesso de novas pessoas passa a ser só por convite.
REGISTRATION_ENABLED=true

# =============================================================================
# 6. Proxies à frente da API
# =============================================================================
# Quantidade de proxies confiáveis. 1 = só o Caddy deste compose (default).
# Use 2 se houver uma CDN (ex.: Cloudflare em modo proxied) na frente dele.
# Valor maior do que a realidade permite ao cliente forjar o próprio IP e furar
# o rate limit de /auth/*.
TRUST_PROXY_HOPS=1

# =============================================================================
# 7. SMTP  (opcional)
# =============================================================================
# Sem SMTP_HOST não há envio de e-mail: o link de redefinição de senha só é
# escrito no log do container, e o convite de colaborador não chega. Para uso
# real com mais de uma pessoa, configure.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false          # true para a porta 465 (TLS implícito)
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=CRM <no-reply@suaempresa.com.br>

# =============================================================================
# 8. Login social  (opcional — em branco desabilita o provedor)
# =============================================================================
# Cadastre EXATAMENTE esta URL de callback no console do provedor:
#   https://<CRM_DOMAIN>/api/v1/auth/oauth/google/callback
#   https://<CRM_DOMAIN>/api/v1/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# =============================================================================
# 9. Captcha no cadastro — Cloudflare Turnstile  (opcional)
# =============================================================================
# As duas andam em par. Recomendado se você mantiver o autocadastro aberto.
# VITE_TURNSTILE_SITE_KEY é embutida no bundle em BUILD-TIME: mudá-la exige
# `up -d --build`, não só reiniciar.
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# =============================================================================
# 10. Ingestão externa de lead  (sem configuração aqui)
# =============================================================================
# `POST /api/v1/leads/intake` não precisa de variável de ambiente: ele autentica
# por CHAVE DE INTEGRAÇÃO, que você emite dentro do app, em
# Administração → Captação, junto do canal. A chave já diz qual workspace recebe,
# quem atende e qual fonte classifica o lead.
#
# O token de instância (LEAD_INTAKE_TOKEN) e o e-mail do owner de destino
# (LEAD_INTAKE_OWNER_EMAIL) eram o caminho legado single-tenant, e saíram na
# Fase 19-B. Se você tem alguma das duas no seu .env, pode apagar.

# =============================================================================
# 10-B. Segundo fator (TOTP)  (opcional — em branco desliga o 2FA)
# =============================================================================
# Chave de cifra do segredo TOTP: 32 bytes em hex.
#   openssl rand -hex 32
# Em branco, a aba Configurações → Segurança mostra "indisponível nesta
# instalação" e ninguém consegue ligar 2FA — mesmo tratamento de SMTP e captcha.
# Ligar depois é aditivo e não quebra nada.
#
# ATENÇÃO: perder esta chave DEPOIS de alguém ter ligado o 2FA inutiliza o
# segundo fator de todas as contas ao mesmo tempo (o segredo cifrado fica
# irrecuperável). Guarde-a junto dos JWT_*, no mesmo backup de segredo.
TOTP_ENCRYPTION_KEY=

# =============================================================================
# 11. Billing por Stripe  (opcional — deixe false)
# =============================================================================
# Só faz sentido em instância que cobra assinatura dos próprios usuários.
# false desliga o gate de assinatura e o Stripe nunca é inicializado.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
