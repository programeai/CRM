# .env de produção — usado por docker-compose.prod.yml.
# Copie para `.env` (cp .env.example .env) e TROQUE TODOS OS SEGREDOS abaixo.
# NÃO comite o `.env` real (já está no .gitignore). Nenhum valor real aqui.

# --- Banco de dados (serviço postgres do compose) ---
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=crm_db

# --- Conexões usadas pela API ---
# Apontam para o serviço `postgres` da rede do compose (host: postgres, porta: 5432).
# DATABASE_URL: role de migrations/seed/crons (superuser, bypassa RLS) — deve
#   usar as mesmas credenciais de POSTGRES_USER/POSTGRES_PASSWORD acima.
DATABASE_URL="postgresql://crm_user:troque-esta-senha@postgres:5432/crm_db?schema=public"
# APP_DATABASE_URL: role da aplicação (crm_app, só DML, sujeita ao RLS).
# A role crm_app é criada por uma migration com senha de dev — troque a senha
# dessa role em produção (ALTER ROLE) e reflita aqui.
APP_DATABASE_URL="postgresql://crm_app:troque-esta-senha-app@postgres:5432/crm_db?schema=public"

# --- JWT (gere segredos fortes, ≥32 caracteres cada) ---
JWT_ACCESS_SECRET="troque-por-um-segredo-forte-de-no-minimo-32-caracteres"
JWT_REFRESH_SECRET="troque-por-outro-segredo-forte-de-no-minimo-32-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# --- URLs públicas ---
# FRONTEND_URL: origem do front (usada em CORS e no link de redefinição de senha).
FRONTEND_URL="http://localhost:8080"
# COOKIE_DOMAIN: domínio do cookie de refresh (ajuste para o seu domínio real).
COOKIE_DOMAIN="localhost"
# API_URL: base pública da API (usada no redirect_uri do OAuth).
API_URL="http://localhost:3000"
# VITE_API_URL: injetada no build do front (base da API que o navegador chama).
VITE_API_URL="http://localhost:3000/api/v1"

# --- OAuth (opcional; em branco desabilita o provedor) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Captcha Cloudflare Turnstile (opcional; em branco desativa) ---
TURNSTILE_SECRET_KEY=""

# --- SMTP (opcional; sem SMTP_HOST o link de redefinição é só logado) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="CRM ProgrameAi <no-reply@example.com>"
