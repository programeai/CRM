# Contrato de variáveis de PRODUÇÃO (docker-compose.prod.yml).
#
# Em produção você não copia este arquivo para a VPS na mão: cada variável aqui
# é um **GitHub Secret** (Settings → Secrets and variables → Actions) e o
# workflow .github/workflows/deploy.yml escreve o `.env` no diretório de deploy
# a cada release. Use este arquivo como a lista do que precisa estar cadastrado.
#
# Nenhum valor real aqui. Para desenvolvimento local use `pnpm dev` +
# docker-compose.yml e os `.env` de cada app (apps/api/.env.example,
# apps/web/.env.example).

# --- Docker Hub (apenas GitHub Secrets) ---
DOCKERHUB_USERNAME=seu-usuario-dockerhub
DOCKERHUB_TOKEN=token-de-acesso-do-dockerhub   # não vai para o .env da VPS

# --- Acesso SSH à VPS (apenas GitHub Secrets) ---
SSH_HOST=203.0.113.10
SSH_USER=deploy
SSH_PORT=22
SSH_KEY=-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----

# --- Domínio ---
# Host único: o front responde em / e a API em /api (mesma origem). O compose
# monta FRONTEND_URL, API_URL e COOKIE_DOMAIN a partir daqui, e o Traefik emite
# o certificado para este host.
CRM_DOMAIN=crm.programeai.com.br

# --- Banco de dados (serviço postgres do compose) ---
# DATABASE_URL e APP_DATABASE_URL NÃO são secrets: o compose as monta a partir
# destas variáveis, apontando para o host interno `postgres`.
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=crm_db
# Senha da role de aplicação `crm_app` (NOSUPERUSER/NOBYPASSRLS, sujeita ao RLS).
# A migration cria a role com senha de desenvolvimento; o entrypoint da API
# aplica esta senha no banco (ALTER ROLE) a cada start.
# Gere com: openssl rand -hex 32   (sem apóstrofo nem barra invertida)
APP_DB_PASSWORD=troque-por-32-bytes-hex-aleatorios

# --- JWT (gere segredos fortes, ≥32 caracteres cada) ---
# Gere cada um com: openssl rand -hex 32
JWT_ACCESS_SECRET=troque-por-32-bytes-hex-aleatorios
JWT_REFRESH_SECRET=troque-por-outro-32-bytes-hex-aleatorios
# Opcionais (defaults no compose: 15m / 7d).
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Build do front (embutido no bundle em build-time) ---
# Caminho relativo: mesma origem do front, roteado pelo Traefik até a API.
VITE_API_URL=/api/v1
# Site key do captcha do registro (par da TURNSTILE_SECRET_KEY). Vazia desativa.
VITE_TURNSTILE_SITE_KEY=

# --- OAuth (opcional; em branco desabilita o provedor) ---
# O redirect_uri é https://${CRM_DOMAIN}/api/v1/auth/oauth/<provider>/callback —
# cadastre exatamente essa URL no console do provedor.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Captcha Cloudflare Turnstile (opcional; em branco desativa) ---
TURNSTILE_SECRET_KEY=

# --- SMTP (opcional; sem SMTP_HOST o link de redefinição é só logado) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=CRM ProgrameAi <no-reply@programeai.com.br>

# --- Billing (Stripe) — opcional; false desativa o gate de assinatura ---
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
