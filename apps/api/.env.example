NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://crm_user:crm_password@localhost:5435/crm_db?schema=public"
# Conexão da aplicação: role crm_app (NOSUPERUSER/NOBYPASSRLS, só DML) — sujeita ao RLS.
# A role é criada pela migration create_app_role. Em produção, gerencie a senha
# fora do repositório (ex.: ALTER ROLE no provisionamento) — a migration usa senha de dev.
APP_DATABASE_URL="postgresql://crm_app:crm_app_password@localhost:5435/crm_db?schema=public"
JWT_ACCESS_SECRET="dev-access-secret-troque-em-producao-min-32-chars"
JWT_REFRESH_SECRET="dev-refresh-secret-troque-em-producao-min-32c"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
FRONTEND_URL="http://localhost:5173"
COOKIE_DOMAIN="localhost"

# Base pública da API (usada no redirect_uri do OAuth; deve bater com o provedor)
API_URL="http://localhost:3000"

# OAuth — deixe em branco para desabilitar o provedor.
# Google: https://console.cloud.google.com/apis/credentials
#   Redirect URI autorizado: http://localhost:3000/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# GitHub: https://github.com/settings/developers (OAuth Apps)
#   Authorization callback URL: http://localhost:3000/api/v1/auth/oauth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Captcha no registro — Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile).
# Em branco desativa a verificação. O site key correspondente vai no front (apps/web/.env → VITE_TURNSTILE_SITE_KEY).
TURNSTILE_SECRET_KEY=""

# SMTP — envio de e-mail (redefinição de senha). SMTP_HOST em branco desativa o
# envio: o link de redefinição é apenas logado no console (útil em dev).
# Em dev, um servidor de teste como Mailtrap (https://mailtrap.io) funciona bem.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"        # true para porta 465 (TLS implícito)
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="CRM ProgrameAi <no-reply@example.com>"
