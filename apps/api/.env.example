NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://crm_user:crm_password@localhost:5435/crm_db?schema=public"
# Conexão da aplicação: role crm_app (NOSUPERUSER/NOBYPASSRLS, só DML) — sujeita ao RLS.
# A role é criada pela migration create_app_role. Em produção, gerencie a senha
# fora do repositório (ex.: ALTER ROLE no provisionamento) — a migration usa senha de dev.
APP_DATABASE_URL="postgresql://crm_app:crm_app_password@localhost:5435/crm_db?schema=public"
JWT_ACCESS_SECRET="dev-access-secret-troque-em-producao-min-32-chars"
JWT_REFRESH_SECRET="dev-refresh-secret-troque-em-producao-min-32c"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
FRONTEND_URL="http://localhost:5173"
COOKIE_DOMAIN="localhost"
