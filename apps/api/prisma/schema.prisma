generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- models: este arquivo é a fonte de verdade do modelo de dados.
//     As regras de negócio que os campos servem estão em SPEC.md §3;
//     os invariantes transversais (Decimal(12,2), billingDay 1-28,
//     derivação de OVERDUE) em SPEC.md §4 ---

model User {
  id                         String                   @id @default(uuid())
  name                       String
  email                      String                   @unique
  /// Conta criada por OAuth nasce com uma senha ALEATÓRIA que ninguém conhece —
  /// não com `NULL`. É o que faz `POST /auth/forgot-password` funcionar para ela
  /// sem nenhum caso especial, e é por isso que a redefinição por e-mail é o
  /// único caminho para o login social ganhar uma senha utilizável.
  /// Segue nullable só pelo convite de colaborador ainda não aceito (`acceptedAt`
  /// nulo) e pelas contas OAuth criadas antes desta regra.
  passwordHash               String?
  /// Quando o TITULAR escolheu a senha (cadastro, aceite de convite ou
  /// redefinição). NULL = a senha guardada é a aleatória do OAuth, ou não há
  /// nenhuma. É este campo — nunca `passwordHash IS NOT NULL` — que responde
  /// "esta pessoa sabe uma senha?", pergunta que o `hasPassword` do `/auth/me` e
  /// a reautenticação do encerramento de conta fazem.
  passwordSetAt              DateTime?
  stripeCustomerId           String?                  @unique // billing (SaaS hospedado) — ausente na autohospedagem
  // --- colaboração (ver modelos Role/CollaboratorInvite) ---
  // NULL = este usuário é um owner: dono da workspace, dos dados e da assinatura.
  // Preenchido = colaborador daquele owner. É este valor que vira `app.owner_id`
  // no RLS (ver AccessService + OwnerContextInterceptor), e não o próprio id.
  ownerId                    String?
  owner                      User?                    @relation("Collaborators", fields: [ownerId], references: [id], onDelete: Cascade)
  collaborators              User[]                   @relation("Collaborators")
  // Papel do colaborador. NULL no owner — que tem todas as permissões por definição.
  roleId                     String?
  role                       Role?                    @relation(fields: [roleId], references: [id])
  // Colaborador desativado não autentica e perde o acesso na requisição seguinte.
  active                     Boolean                  @default(true)
  // Quando o convite foi aceito (senha definida). NULL = convite pendente.
  acceptedAt                 DateTime?
  /// Encerramento agendado (Fase 19-A). Os dois campos andam juntos: nulos
  /// (conta normal) ou ambos preenchidos. Só um OWNER pode tê-los — colaborador
  /// não encerra workspace, ele é apagado junto no expurgo.
  ///
  /// A carência de 30 dias existe por duas razões que se somam: protege contra
  /// exclusão por sequestro de conta (é o padrão Atlassian/GitLab) e tira o
  /// trabalho pesado da transação de 5s do request, porque quem expurga é o
  /// `AccountPurgeJob`. O "irreversível" prometido continua verdadeiro: é
  /// irreversível DEPOIS da janela.
  ///
  /// Também são o tombstone que sobrevive a um restore de backup: um `User`
  /// restaurado com `deletionScheduledFor` no passado é expurgado de novo pelo
  /// cron seguinte, sem intervenção.
  deletionRequestedAt        DateTime?
  deletionScheduledFor       DateTime?
  createdAt                  DateTime                 @default(now())
  oauthAccounts              OAuthAccount[]
  passwordResetTokens        PasswordResetToken[]
  sessions                   Session[]
  subscription               Subscription?
  ownedRoles                 Role[]                   @relation("OwnerRoles")
  pipelineStages             PipelineStage[]
  leadSourceCatalog          LeadSourceCatalog[]
  serviceCatalog             ServiceCatalog[]
  activityTypeCatalog        ActivityTypeCatalog[]
  lostReasonCatalog          LostReasonCatalog[]
  assignedClients            Client[]
  assignedDeals              Deal[]
  assignedTasks              Task[]
  assignedActivities         Activity[]
  invites                    CollaboratorInvite[]
  notifications              Notification[]
  notificationTargets        UserNotificationTarget[]
  integrationKeys            IntegrationKey[]
  leadIntakeChannels         LeadIntakeChannel[]      @relation("OwnerLeadIntakeChannels")
  assignedLeadIntakeChannels LeadIntakeChannel[]      @relation("AssignedLeadIntakeChannels")
  ownerWebhooks              OwnerWebhook[]
  ownerWebhookDeliveries     OwnerWebhookDelivery[]
  totp                       UserTotp?
  totpRecoveryCodes          UserTotpRecoveryCode[]
  consentRecords             ConsentRecord[]

  @@index([ownerId])
  @@index([deletionScheduledFor])
}

// Papel de colaborador: um conjunto de chaves do catálogo em
// `src/shared/permissions.ts`. Escopado ao owner (RLS por ownerId) — dois owners
// podem ter papéis de mesmo nome sem se verem.
model Role {
  id          String   @id @default(uuid())
  ownerId     String
  owner       User     @relation("OwnerRoles", fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  // Papel criado junto com a conta ("Administrador"): não é editável nem
  // excluível e vale SEMPRE o catálogo inteiro (resolvido no AccessService), de
  // modo que uma permissão nova não deixa o papel desatualizado.
  system      Boolean  @default(false)
  permissions String[] @default([])
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([ownerId, name])
  @@index([ownerId])
}

// Convite de colaborador. Guarda apenas o sha256 do token que vai no link — o
// valor bruto só existe no e-mail/link entregue ao convidado. Uso único.
model CollaboratorInvite {
  id        String    @id @default(uuid())
  ownerId   String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // sha256 do token bruto enviado no link
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([ownerId])
}

// Chave de integração do owner: credencial de MÁQUINA (servidor a servidor).
//
// Guarda apenas o sha256 do valor bruto — que só existe na resposta que o
// emitiu. Determinístico e `@unique` (não argon2, como `Session`) porque a
// chave chega SOZINHA no header `Authorization`, sem identificador ao lado: a
// autenticação tem de ser um `findUnique` indexado, e não N `argon2.verify`.
// Mesma decisão de `CollaboratorInvite.tokenHash`.
//
// Genérico de propósito: o que a chave pode fazer está em `scopes`, e escopo
// novo (webhook de saída, API pública — Fase 19-B) entra sem tocar em nada
// aqui. Este modelo NÃO conhece lead: a configuração de captação vive em
// `LeadIntakeChannel`.
model IntegrationKey {
  id                String             @id @default(uuid())
  ownerId           String
  owner             User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Nome dado por quem criou ("Site institucional", "n8n").
  name              String
  keyHash           String             @unique // sha256 do valor bruto
  /// Os 12 primeiros caracteres do valor bruto, em claro (`crm_` + 8 hex). É o
  /// que a interface exibe para a pessoa reconhecer qual chave é qual — os
  /// outros 224 bits de entropia continuam só no hash.
  prefix            String
  scopes            String[]           @default([])
  /// Último uso BEM-SUCEDIDO (a transação da ingestão commitou).
  lastUsedAt        DateTime?
  /// Revogada: continua no banco para a trilha e para a tela dizerem o que
  /// aconteceu, mas não autentica mais nada.
  revokedAt         DateTime?
  createdAt         DateTime           @default(now())
  leadIntakeChannel LeadIntakeChannel?

  @@index([ownerId])
}

// Canal de captação de lead: uma origem externa que entrega lead ao CRM
// ("Site institucional", "Landing agenda cheia", "n8n").
//
// Guarda a configuração de ROTEAMENTO — quem atende e como o lead é
// classificado — e a chave que autentica a entrega. Um canal, uma chave:
// revogar um canal não derruba os outros, que é o ponto de existirem N.
//
// Esta tabela é do domínio de lead e mora em `modules/leads`; a credencial em
// si é genérica e mora em `modules/integracoes`. A dependência aponta
// leads → integracoes, nunca o contrário.
model LeadIntakeChannel {
  id         String             @id @default(uuid())
  ownerId    String
  owner      User               @relation("OwnerLeadIntakeChannels", fields: [ownerId], references: [id], onDelete: Cascade)
  name       String
  /// Responsável de todo lead que entra por aqui. Opcional: sem ele o lead
  /// nasce sem responsável e continua visível para a workspace inteira
  /// (`shared/record-scope.ts:10-11`). `SetNull` porque apagar um usuário não
  /// pode apagar a configuração do owner.
  assigneeId String?
  assignee   User?              @relation("AssignedLeadIntakeChannels", fields: [assigneeId], references: [id], onDelete: SetNull)
  /// Fonte de lead gravada no cadastro. `Restrict` como `Client.sourceId`:
  /// excluir uma fonte em uso não apaga a configuração.
  sourceId   String?
  source     LeadSourceCatalog? @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  /// A chave que autentica este canal. `SetNull` para o canal sobreviver ao
  /// apagar da chave — sem chave ele existe, configurado e mudo.
  keyId      String?            @unique
  key        IntegrationKey?    @relation(fields: [keyId], references: [id], onDelete: SetNull)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([ownerId, name])
  @@index([ownerId])
  @@index([sourceId])
}

enum OAuthProvider {
  GOOGLE
  GITHUB
}

// Vínculo entre um usuário e uma identidade de provedor OAuth (Google/GitHub).
// Um usuário pode ter vários provedores; cada identidade de provedor é única.
model OAuthAccount {
  id                String        @id @default(uuid())
  provider          OAuthProvider
  providerAccountId String // id do usuário no provedor (sub/id)
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Token de redefinição de senha. Guardamos apenas o hash (sha256) do token bruto
// enviado no link do e-mail; o token tem alta entropia (32 bytes aleatórios), então
// sha256 basta e permite busca indexada. Fica fora do RLS (ligado a User).
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // sha256 do token bruto enviado no link
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Sessão de refresh: uma linha por dispositivo logado. Substitui o antigo
// hash único de refresh em `User`, que permitia apenas uma sessão por usuário.
//
// Fica FORA do RLS, no mesmo grupo de User/OAuthAccount/PasswordResetToken: a
// linha nasce no login, que é rota @Public() e roda sem `app.owner_id` — uma
// policy `owner_isolation` aqui fecharia a escrita (fail-closed = zero linhas).
// O isolamento é por filtro explícito de `userId` no SessionsService.
//
// `tokenHash` é o argon2 do refresh token VIGENTE: cada refresh rotaciona o
// token e reescreve o hash na MESMA sessão (o `sid` do payload é estável).
// argon2 (e não sha256, como o token de reset) porque o `sid` vem no payload —
// a busca é por chave primária, e o hash não precisa ser indexável.
model Session {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String
  /// Aparelho de onde a sessão veio: o cookie `device_id`, estável entre logins
  /// (ver `modules/auth/device-cookie.ts`). É o que faz a tela "Dispositivos"
  /// listar aparelhos e não logins — o login novo revoga a sessão anterior do
  /// MESMO `deviceId`. Nulo em sessão anterior ao cookie; o primeiro refresh
  /// preenche, e a que nunca mais for usada morre com o `expiresAt`.
  deviceId   String?
  /// User-Agent cru da requisição que criou/renovou a sessão (truncado em 255).
  userAgent  String?
  /// IP do cliente (req.ip, já resolvido por trust proxy — ver main.ts).
  ip         String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  /// Janela deslizante: cada refresh empurra a expiração, igual ao maxAge do cookie.
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId, revokedAt])
  /// Serve à revogação da sessão anterior do mesmo aparelho, no login.
  @@index([userId, deviceId])
  @@index([expiresAt])
}

// Assinatura SaaS (billing hospedado, via Stripe) — 1 por owner. Espelho local
// do estado da assinatura no Stripe, sincronizado pelo webhook; usado só para
// o gate de acesso (BillingGuard). Tem RLS por ownerId (ver migration).
model Subscription {
  id                   String             @id @default(uuid())
  ownerId              String             @unique
  owner                User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(TRIALING)
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model Client {
  id         String             @id @default(uuid())
  ownerId    String // preparação p/ multiusuário
  name       String
  tradeName  String?
  personType PersonType         @default(COMPANY) // INDIVIDUAL | COMPANY
  document   String? // CPF/CNPJ
  email      String?
  phone      String?
  website    String?
  sourceId   String?
  source     LeadSourceCatalog? @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  status     ClientStatus       @default(LEAD) // LEAD | ACTIVE | INACTIVE | LOST
  tags       String[]
  notes      String?
  // --- endereço (opcional, campos simples) ---
  zipCode    String?
  street     String?
  number     String?
  complement String?
  district   String?
  city       String?
  state      String? // UF
  // --- soft delete ---
  archivedAt DateTime?
  // Responsável pelo registro. Opcional: registro sem responsável é visível para
  // quem só enxerga os próprios (ver `shared/record-scope.ts`). `SetNull` porque
  // apagar um usuário não pode apagar o dado de negócio do owner.
  assigneeId String?
  assignee   User?              @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  contacts   Contact[]
  activities Activity[]
  deals      Deal[]
  proposals  Proposal[]
  projects   Project[]
  contracts  Contract[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([ownerId, status])
  @@index([ownerId, archivedAt])
  @@index([ownerId, assigneeId])
  @@index([sourceId])
}

model Contact {
  id         String    @id @default(uuid())
  ownerId    String // denormalizado p/ RLS (== Client.ownerId)
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id])
  name       String
  role       String?
  email      String?
  phone      String?
  isPrimary  Boolean   @default(false)
  // --- soft delete (ver Client.archivedAt e o módulo trash) ---
  archivedAt DateTime?

  @@index([ownerId])
  @@index([ownerId, archivedAt])
}

// Estágios do funil, por owner. Cada owner tem o seu conjunto (criado junto com
// a conta — ver UsersService) e o configura livremente, sem afetar ninguém:
// `@@unique([ownerId, name])` permite dois owners com um "Negociação" cada.
// Tem RLS por ownerId (ver migration 20260726120000_pipeline_stages_per_owner).
model PipelineStage {
  id      String  @id @default(uuid())
  ownerId String
  owner   User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name    String
  order   Int
  isWon   Boolean @default(false)
  isLost  Boolean @default(false)
  deals   Deal[]

  @@unique([ownerId, name])
  @@index([ownerId])
}

// --- catálogos por owner (Fase 13-A) ---------------------------------------
// Quatro tabelas irmãs (ServiceCatalog, LeadSourceCatalog, ActivityTypeCatalog,
// LostReasonCatalog) substituem enums fechados e um texto livre. Todas seguem o
// molde de PipelineStage: `ownerId` + RLS, `@@unique([ownerId, name])` (dois
// owners podem ter um "Indicação" cada) e provisionamento na criação da conta
// a partir de `shared/default-catalogs.ts`.
//
// `active` NÃO é estado escolhido por ninguém e nunca aparece na interface: é
// como o DELETE se comporta quando o item ainda rotula registros. Sem uso, a
// linha é apagada; em uso, as FKs RESTRICT (três delas NOT NULL) impedem o
// DELETE, então ela vira `active: false` — some do GET e de todo Select, e
// sobrevive só embutida nos registros que já a carregavam. Cadastrar o mesmo
// nome de novo ressuscita a linha. Ver `CatalogosService.delete`/`create`.

/// Fontes de lead do owner. Substitui o enum fechado `LeadSource`.
model LeadSourceCatalog {
  id                 String              @id @default(uuid())
  ownerId            String
  owner              User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name               String
  active             Boolean             @default(true)
  clients            Client[]
  leadIntakeChannels LeadIntakeChannel[]

  @@unique([ownerId, name])
  @@index([ownerId])
}

/// Tipos de serviço do owner. Substitui o enum fechado `ServiceType`, que era
/// NOT NULL em Deal, Proposal e Project — daí as três back-relations.
model ServiceCatalog {
  id        String     @id @default(uuid())
  ownerId   String
  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  active    Boolean    @default(true)
  deals     Deal[]
  proposals Proposal[]
  projects  Project[]

  @@unique([ownerId, name])
  @@index([ownerId])
}

/// Tipos de atividade do owner. Substitui o enum fechado `ActivityType`.
model ActivityTypeCatalog {
  id         String     @id @default(uuid())
  ownerId    String
  owner      User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name       String
  /// É REGRA, não rótulo: marca o tipo PRIMITIVO 'Follow-up'. O cron de
  /// lembretes (cross-owner, pelo client admin) e o dashboard filtram por ela —
  /// é o análogo de `PipelineStage.isWon`/`isLost`.
  ///
  /// Somente leitura para a aplicação: quem grava é o provisionamento da conta
  /// (`shared/default-catalogs.ts`) e as migrations. Não há DTO, rota ou método
  /// de repositório que a altere — e o `delete` do service responde 422 no item
  /// marcado, porque excluí-lo (ou só ocultá-lo) silenciaria os lembretes do
  /// owner sem erro nenhum. Exatamente um item ativo por owner, conferido pelo
  /// portão de CI em `prisma/fixtures/invariantes.sql`; índice parcial não
  /// entrou porque o schema do Prisma não o expressa e ele viraria drift.
  isFollowUp Boolean    @default(false)
  active     Boolean    @default(true)
  activities Activity[]

  @@unique([ownerId, name])
  @@index([ownerId])
  @@index([isFollowUp]) // ← o cron cross-owner filtra pela relação
}

/// Motivos de perda do owner. Substitui o texto livre `Deal.lostReason`.
model LostReasonCatalog {
  id      String  @id @default(uuid())
  ownerId String
  owner   User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name    String
  active  Boolean @default(true)
  deals   Deal[]

  @@unique([ownerId, name])
  @@index([ownerId])
}

model Deal {
  id            String             @id @default(uuid())
  ownerId       String // denormalizado p/ RLS (== Client.ownerId)
  clientId      String
  client        Client             @relation(fields: [clientId], references: [id])
  stageId       String
  stage         PipelineStage      @relation(fields: [stageId], references: [id])
  title         String
  serviceTypeId String
  serviceType   ServiceCatalog     @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)
  amount        Decimal?           @db.Decimal(12, 2)
  probability   Int? // 0–100
  expectedClose DateTime?
  lostReasonId  String?
  lostReason    LostReasonCatalog? @relation(fields: [lostReasonId], references: [id], onDelete: Restrict)
  position      Int // ordenação na coluna
  stageMovedAt  DateTime           @default(now()) // p/ indicador "esfriando"
  // --- soft delete (ver Client.archivedAt e o módulo trash) ---
  archivedAt    DateTime?
  // Responsável pelo registro — ver Client.assigneeId.
  assigneeId    String?
  assignee      User?              @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  proposals     Proposal[]
  projects      Project[] // back-relation p/ Project.deal (criar-ao-ganhar)
  activities    Activity[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([stageId, position])
  @@index([ownerId])
  @@index([ownerId, assigneeId])
  @@index([ownerId, archivedAt])
  @@index([lostReasonId])
  @@index([serviceTypeId])
  // Gatilho DEAL_STALE: o cron varre cross-owner por `archivedAt IS NULL` +
  // `stageMovedAt` antigo. Igualdade antes da faixa, no molde de
  // Task.[dueDate, status] — sem ele a rotina diária seria seq scan em Deal.
  @@index([archivedAt, stageMovedAt])
}

model Proposal {
  id                    String         @id @default(uuid())
  ownerId               String // denormalizado p/ RLS (== Client.ownerId)
  // O número identifica a CADEIA, não a linha: todas as versões de uma proposta
  // compartilham o mesmo `number` e se distinguem por `version` (ver
  // `newVersion`). Por isso o unique é o PAR — ver `@@unique` no fim do model.
  number                String // PROP-2026-0042
  version               Int            @default(1)
  parentId              String? // versão anterior
  parent                Proposal?      @relation("ProposalVersions", fields: [parentId], references: [id])
  versions              Proposal[]     @relation("ProposalVersions")
  clientId              String
  client                Client         @relation(fields: [clientId], references: [id])
  dealId                String?
  deal                  Deal?          @relation(fields: [dealId], references: [id])
  serviceTypeId         String
  serviceType           ServiceCatalog @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)
  status                ProposalStatus @default(DRAFT) // DRAFT | SENT | NEGOTIATING | ACCEPTED | REJECTED | EXPIRED
  scope                 String? // markdown
  paymentTerms          String?
  deliveryTime          String?
  validUntil            DateTime?
  discount              Decimal?       @db.Decimal(12, 2)
  total                 Decimal        @db.Decimal(12, 2) // calculado no backend
  // ⚠ Em proposta de plano RECURRING, `total` significa VALOR MENSAL (Σ dos
  // itens é a mensalidade). Quem soma `total` de várias propostas mistura
  // grandezas — é o caso de DashboardRepository.proposalsOpen.
  // --- plano de cobrança (estrutura que deriva o Contract) ------------------
  // Só a ESTRUTURA e os PRAZOS. Nenhum valor sai daqui: os valores vêm de
  // `total` na derivação (finance/application/proposal-plan.ts). Os prazos são
  // OFFSETS EM DIAS relativos ao aceite, nunca datas absolutas — o plano é
  // escrito antes de existir aceite, e a derivação ancora em `decidedAt`.
  // Nullable no banco só pelo histórico já gravado; obrigatório no DTO.
  billingType           BillingType? // RECURRING | INSTALLMENTS | ONE_TIME
  startOffsetDays       Int? // dias após o aceite: startDate (REC) | 1ª parcela (INST) | vencimento (ONE)
  // RECURRING
  billingDay            Int? // 1–28 (dia do mês, não offset — Contract.billingDay é assim)
  durationMonths        Int? // null = tempo indeterminado
  // INSTALLMENTS
  downPaymentPercent    Decimal?       @db.Decimal(5, 2) // 0–100, exclusivo com downPaymentAmount
  downPaymentAmount     Decimal?       @db.Decimal(12, 2) // exclusivo com downPaymentPercent
  downPaymentOffsetDays Int? // dias após o aceite p/ a entrada
  installments          Int? // qtd de parcelas (sem contar a entrada)
  items                 ProposalItem[]
  projects              Project[]
  contracts             Contract[]
  activities            Activity[]
  sentAt                DateTime?
  decidedAt             DateTime? // aceite/recusa
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  // Uma linha por (cadeia, versão). Substitui o `@unique` que estava em
  // `number` sozinho e que tornava o versionamento IMPOSSÍVEL: `newVersion`
  // grava o mesmo `number` com `version + 1` e batia em P2002 sempre, então
  // `POST /proposals/:id/new-version` respondia 500 em toda proposta.
  // O índice também cobre as buscas por `number` sozinho (prefixo à esquerda),
  // que é o que `findVersionsByNumber` faz.
  @@unique([number, version])
  @@index([clientId, status])
  @@index([ownerId])
  @@index([validUntil, status]) // ← gatilho (b), varredura cross-owner
  @@index([serviceTypeId])
}

model ProposalItem {
  id          String   @id @default(uuid())
  ownerId     String // denormalizado p/ RLS (== Proposal.ownerId)
  proposalId  String
  proposal    Proposal @relation(fields: [proposalId], references: [id])
  description String
  quantity    Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  order       Int

  @@index([ownerId])
}

model Project {
  id            String         @id @default(uuid())
  ownerId       String // denormalizado p/ RLS (== Client.ownerId)
  clientId      String
  client        Client         @relation(fields: [clientId], references: [id])
  proposalId    String?
  proposal      Proposal?      @relation(fields: [proposalId], references: [id])
  dealId        String? // origem: deal ganho (dedupe de criar-ao-ganhar)
  deal          Deal?          @relation(fields: [dealId], references: [id])
  name          String
  serviceTypeId String
  serviceType   ServiceCatalog @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)
  status        ProjectStatus  @default(ACTIVE) // ACTIVE | PAUSED | DONE | CANCELED
  startDate     DateTime?
  dueDate       DateTime?
  // --- soft delete (ver Client.archivedAt e o módulo trash) ---
  archivedAt    DateTime?
  tasks         Task[]
  contracts     Contract[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([dealId])
  @@index([ownerId])
  @@index([ownerId, archivedAt])
  @@index([serviceTypeId])
}

model Task {
  id          String       @id @default(uuid())
  ownerId     String // denormalizado p/ RLS (== Project.ownerId)
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id])
  title       String
  description String? // markdown
  status      TaskStatus   @default(BACKLOG) // BACKLOG | TODO | IN_PROGRESS | REVIEW | DONE
  priority    TaskPriority @default(MEDIUM) // LOW | MEDIUM | HIGH | URGENT
  dueDate     DateTime?
  position    Int
  tags        String[]
  checklist   Json? // [{ text, done }]
  completedAt DateTime?
  // --- soft delete (ver Client.archivedAt e o módulo trash) ---
  archivedAt  DateTime?
  // Responsável pelo registro — ver Client.assigneeId.
  assigneeId  String?
  assignee    User?        @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([projectId, status, position])
  @@index([ownerId])
  @@index([ownerId, assigneeId])
  @@index([ownerId, archivedAt])
  @@index([dueDate, status]) // ← gatilho (e), varredura cross-owner
}

model Contract {
  id                String         @id @default(uuid())
  ownerId           String // denormalizado p/ RLS (== Client.ownerId)
  clientId          String
  client            Client         @relation(fields: [clientId], references: [id])
  projectId         String?
  project           Project?       @relation(fields: [projectId], references: [id])
  // Um contrato por proposta: é a idempotência da derivação (dois cliques no
  // botão "Gerar contrato" não podem virar dois contratos). No Postgres NULLs
  // são distintos, então este @unique numa coluna nullable já vale "no máximo
  // um contrato por proposta E quantos contratos se quiser sem proposta" — não
  // é preciso índice parcial. A regra mais forte (um contrato por CADEIA de
  // versões) fica no ContractsService: `number` não existe aqui.
  proposalId        String?        @unique
  proposal          Proposal?      @relation(fields: [proposalId], references: [id])
  description       String
  billingType       BillingType // RECURRING | INSTALLMENTS | ONE_TIME
  status            ContractStatus @default(ACTIVE) // ACTIVE | PAUSED | FINISHED | CANCELED
  // RECURRING
  monthlyAmount     Decimal?       @db.Decimal(12, 2)
  billingDay        Int? // 1–28
  startDate         DateTime?
  endDate           DateTime? // null = tempo indeterminado
  // INSTALLMENTS
  downPayment       Decimal?       @db.Decimal(12, 2)
  installments      Int? // qtd de parcelas (sem contar entrada)
  installmentAmount Decimal?       @db.Decimal(12, 2)
  payments          Payment[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([clientId, status])
  @@index([ownerId])
}

model Payment {
  id          String         @id @default(uuid())
  ownerId     String // denormalizado p/ RLS (== Contract.ownerId)
  contractId  String
  contract    Contract       @relation(fields: [contractId], references: [id])
  description String // "Entrada", "Parcela 3/8", "Mensalidade 07/2026"
  amount      Decimal        @db.Decimal(12, 2)
  dueDate     DateTime
  status      PaymentStatus  @default(PENDING) // PENDING | PAID | OVERDUE | CANCELED
  paidAt      DateTime?
  paidAmount  Decimal?       @db.Decimal(12, 2) // permite recebimento parcial/diferente
  method      PaymentMethod? // PIX | TRANSFER | BOLETO | CARD | CASH
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([contractId, status])
  @@index([dueDate, status])
  @@index([ownerId])
}

model Activity {
  id           String              @id @default(uuid())
  ownerId      String // denormalizado p/ RLS (== Client.ownerId)
  clientId     String
  client       Client              @relation(fields: [clientId], references: [id])
  dealId       String?
  deal         Deal?               @relation(fields: [dealId], references: [id])
  proposalId   String?
  proposal     Proposal?           @relation(fields: [proposalId], references: [id])
  typeId       String
  type         ActivityTypeCatalog @relation(fields: [typeId], references: [id], onDelete: Restrict)
  content      String
  scheduledFor DateTime? // follow-ups
  completedAt  DateTime?
  // Responsável pelo registro — ver Client.assigneeId.
  assigneeId   String?
  assignee     User?               @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt    DateTime            @default(now())

  @@index([clientId, createdAt])
  @@index([ownerId])
  @@index([ownerId, assigneeId])
  @@index([scheduledFor, completedAt]) // ← gatilho (a), varredura cross-owner
  @@index([typeId])
}

/// Trilha de auditoria: uma linha por mudança sensível de estado.
///
/// Tem RLS por ownerId (template `owner_isolation`) e é IMUTÁVEL para a
/// aplicação: a migration revoga UPDATE/DELETE de `crm_app`. Uma trilha que o
/// próprio app pode reescrever tem valor limitado.
///
/// `actorName` e `entityLabel` são DENORMALIZADOS de propósito: a tela de
/// auditoria não faz join, e o registro guarda o que era verdade no momento da
/// ação — renomear um colaborador ou um contrato não reescreve o passado.
model AuditLog {
  id          String         @id @default(uuid())
  ownerId     String
  actorType   AuditActorType @default(USER)
  /// `null` quando actorType != USER. Sem FK: apagar um usuário não pode apagar a trilha.
  actorId     String?
  /// Nome de quem agiu no momento da ação ("Rotina diária", "Webhook do Stripe" no caso não-humano).
  actorName   String
  entity      AuditEntity
  entityId    String
  /// Rótulo humano do registro no momento da ação ("Mensalidade 07/2026").
  entityLabel String
  action      AuditAction
  /// `{ campo: { antes, depois } }` — só os campos alterados. Ver shared/audit-diff.ts.
  diff        Json?
  /// Mesmo `x-request-id` do log estruturado — amarra a trilha ao Loki.
  requestId   String?
  createdAt   DateTime       @default(now())

  @@index([ownerId, createdAt])
  @@index([ownerId, entity, entityId, createdAt])
  @@index([ownerId, actorId, createdAt])
  /// Serve à faxina por data de corte (Fase 19-B). Os índices acima têm
  /// `ownerId` como coluna LÍDER, e prefixo à esquerda não serve a um filtro
  /// CROSS-OWNER que só tem data — sem este, a varredura diária vira seq scan.
  @@index([createdAt])
}

// --- enums do domínio ---
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum PersonType {
  INDIVIDUAL
  COMPANY
}

enum ClientStatus {
  LEAD
  ACTIVE
  INACTIVE
  LOST
}

enum ProposalStatus {
  DRAFT
  SENT
  NEGOTIATING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  DONE
  CANCELED
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum BillingType {
  RECURRING
  INSTALLMENTS
  ONE_TIME
}

enum ContractStatus {
  ACTIVE
  PAUSED
  FINISHED
  CANCELED
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELED
}

enum PaymentMethod {
  PIX
  TRANSFER
  BOLETO
  CARD
  CASH
}

// --- auditoria (Fase 8B) ---

/// Natureza de quem agiu. USER é o único caso com `actorId` preenchido.
enum AuditActorType {
  USER
  CRON
  WEBHOOK
  SISTEMA
  INTEGRACAO // ← Fase 19-B: escrita pela API pública, por chave de integração
}

/// Registro afetado. Cresce conforme a trilha cobre mais domínio.
enum AuditEntity {
  CLIENT
  CONTACT
  DEAL
  PROPOSAL
  PROJECT
  TASK
  CONTRACT
  PAYMENT
  ROLE
  USER
  SUBSCRIPTION
  ACTIVITY // ← Fase 9: alvo dos gatilhos de follow-up e de atribuição
  IMPORT // ← Fase 14-A: a importação em massa, não o cliente/contato individual
  INTEGRATION // ← Fase 17-A: emissão e rotação de chave de integração
  ACCOUNT // ← Fase 19-A: a conta/workspace como um todo, não o colaborador (USER)
  WEBHOOK // ← Fase 19-B: webhook de saída do owner (cadastro, rotação, exclusão)
}

/// O que aconteceu. Verbo no infinitivo, no vocabulário do domínio.
enum AuditAction {
  CRIAR
  ATUALIZAR
  EXCLUIR
  ARQUIVAR
  RESTAURAR
  EXPURGAR
  PAGAR
  ESTORNAR
  CANCELAR
  PAUSAR
  RETOMAR
  ENVIAR
  ACEITAR
  RECUSAR
  NOVA_VERSAO
  CONVIDAR
  ATIVAR
  DESATIVAR
  ALTERAR_PAPEL
  EXPIRAR
  VENCER
  IMPORTAR // ← Fase 14-A: importação de clientes/contatos em massa
  ROTACIONAR // ← Fase 17-A: rotação de chave de integração
  EXPORTAR // ← Fase 19-A: portabilidade dos dados do titular
  ENCERRAR // ← Fase 19-A: pedido de encerramento da conta (o expurgo usa EXPURGAR)
}

// --- registro de acesso (Fase 19-A) ---

/// Natureza do acesso registrado. Só eventos BEM-SUCEDIDOS: art. 15 fala de
/// registro de *acesso*, e guardar o IP de uma tentativa frustrada seria dado
/// pessoal a mais sem obrigação que o exija.
enum AccessRecordKind {
  LOGIN
  LOGIN_OAUTH
  /// Aceite de convite de colaborador — o primeiro acesso daquela pessoa.
  ACEITE_DE_CONVITE
  LOGOUT
  /// ← Fase 19-B: login que passou pelo segundo fator. Distingue do LOGIN comum
  /// porque os dois são acessos bem-sucedidos de natureza diferente. Tentativa
  /// FALHA de 2FA continua fora desta tabela (ver o docblock do modelo).
  LOGIN_2FA
}

/// Registro de acesso à aplicação, na definição do Marco Civil (art. 5º, VIII):
/// data/hora de uso da aplicação a partir de um endereço IP. Guardado por
/// **6 meses**, por OBRIGAÇÃO legal (art. 15) — não é faculdade e não é
/// configurável.
///
/// Uma linha por evento de AUTENTICAÇÃO, não por requisição HTTP. A lei pede
/// data/hora + IP do uso, e uma linha por rota faria dezenas de milhares por dia
/// sem acrescentar nada ao que ela pede. O log `http.requisicao` (→ Loki, 30
/// dias) continua sendo a ferramenta de diagnóstico; esta tabela é a de
/// conformidade, e as duas respondem perguntas diferentes.
///
/// **Sobrevive ao encerramento da conta.** É o único dado que sobrevive, por
/// LGPD art. 16, I (cumprimento de obrigação legal), e a Política declara isso.
/// Por isso `userId` NÃO tem FK — apagar a conta não pode apagar o registro que a
/// lei manda guardar (mesma decisão de `AuditLog.actorId`).
///
/// FORA do RLS, no grupo de `User`/`Session`/`OAuthAccount`: a linha nasce no
/// login, que é rota `@Public()` e roda sem `app.owner_id` — uma policy aqui
/// fecharia a escrita (fail-closed grava zero linha e a rota responde sucesso).
///
/// Sem `ownerId`: quem responde a uma requisição judicial é o `userId`, e a
/// tabela nunca é exposta na interface. Uma denormalização que não serve a
/// nenhuma consulta é só mais um dado pessoal a guardar.
model AccessRecord {
  id        String           @id @default(uuid())
  /// Sem FK, de propósito (ver o docblock).
  userId    String
  kind      AccessRecordKind
  /// `req.ip`, já resolvido por trust proxy (ver main.ts) — o mesmo valor que o
  /// rate limit e a `Session` usam.
  ip        String?
  userAgent String?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  /// Serve à faxina por data de corte.
  @@index([createdAt])
}

// --- notificações (Fase 9) ---

/// Natureza do destino. Um usuário pode ter N destinos do MESMO kind
/// (dois e-mails, três webhooks) — por isso destino é linha, não coluna.
enum NotificationChannelKind {
  IN_APP
  EMAIL
  WEBHOOK
  SLACK
  DISCORD
  TELEGRAM
}

/// O que aconteceu. Os seis primeiros espelham os gatilhos do ROADMAP.
/// `LEAD_RECEIVED` é o sétimo e vem da ingestão externa (`POST /leads/intake`):
/// é o único emitido por quem não tem sessão, e o único cuja utilidade depende de
/// chegar em MINUTOS — lead que espera o dono abrir o CRM já falou com outro.
/// `DEAL_STALE` é o oitavo: o selo "Esfriando" do quadro existia só como pintura
/// no card, e quem não abria o Pipeline nunca soube que o negócio parou.
enum NotificationType {
  FOLLOW_UP_DUE
  DEAL_STALE
  PROPOSAL_EXPIRING
  PAYMENT_DUE
  PAYMENT_OVERDUE
  TASK_OVERDUE
  RECORD_ASSIGNED
  LEAD_RECEIVED
}

/// Estado de UMA entrega, num destino. `SKIPPED` = o canal existe mas está
/// desligado por configuração (ex.: EMAIL sem SMTP_HOST) — não é falha.
enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

/// O fato notificável, já traduzido para conteúdo neutro em pt-BR. Uma linha
/// por (destinatário, evento); o fan-out para os destinos vive nas deliveries.
///
/// `title`/`body` são DENORMALIZADOS pelo mesmo motivo do `AuditLog.entityLabel`:
/// a central não faz join e o registro guarda o que era verdade na emissão —
/// renomear um cliente não reescreve a notificação de ontem.
model Notification {
  id         String                 @id @default(uuid())
  ownerId    String
  /// Destinatário. CASCADE: apagar o usuário apaga as notificações dele (o
  /// oposto de `assigneeId`, que é dado de negócio do owner e usa SET NULL).
  userId     String
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  entity     AuditEntity
  entityId   String
  /// Título curto em pt-BR ("Cobrança a vencer em 3 dias").
  title      String
  /// Uma frase de corpo em pt-BR. Texto puro — NUNCA HTML (quem renderiza é o adapter).
  body       String
  /// Caminho relativo no front (`/propostas/<id>`). Null quando não há tela de destino.
  link       String?
  /// Contexto estruturado para o adapter usar sem reparsear o corpo.
  data       Json?
  /// Idempotência dos gatilhos recorrentes: `PAYMENT_DUE:<id>:2026-08-01`.
  /// NULL no caminho do request — reatribuir um registro DEVE notificar de novo.
  /// Em Postgres, NULLs são distintos entre si, então o unique abaixo nunca
  /// colide para as notificações sem chave.
  dedupeKey  String?
  createdAt  DateTime               @default(now())
  deliveries NotificationDelivery[]

  @@unique([userId, dedupeKey])
  @@index([ownerId, userId, createdAt])
  /// Serve à faxina por data de corte (Fase 19-B). Mesma razão do índice de
  /// `AuditLog`: a varredura é cross-owner e filtra só por `createdAt`.
  @@index([createdAt])
}

/// Uma tentativa de entrega, num destino. É a linha do outbox.
///
/// `userId` e `createdAt` são denormalizados da `Notification` de propósito: por
/// **D1** o inbox filtra AQUI (`kind='IN_APP'`, `readAt IS NULL`) e ordena por
/// data, e sem a denormalização o índice não cobriria filtro + ordenação juntos.
model NotificationDelivery {
  id             String                     @id @default(uuid())
  ownerId        String
  notificationId String
  notification   Notification               @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  createdAt      DateTime                   @default(now())
  /// SET NULL, não CASCADE: apagar um destino não pode apagar o histórico do
  /// inbox. O dispatch marca SKIPPED a pendente que ficou sem destino.
  targetId       String?
  target         UserNotificationTarget?    @relation(fields: [targetId], references: [id], onDelete: SetNull)
  kind           NotificationChannelKind
  status         NotificationDeliveryStatus @default(PENDING)
  attempts       Int                        @default(0)
  nextAttemptAt  DateTime                   @default(now())
  /// Mensagem de erro TRUNCADA da última tentativa. Nunca a config do destino.
  lastError      String?
  sentAt         DateTime?
  /// Só faz sentido em `kind = IN_APP` — é o "lida" da central (D1).
  readAt         DateTime?

  @@index([ownerId, userId, kind, readAt, createdAt])
  @@index([status, nextAttemptAt])
  @@index([notificationId])
}

/// Um destino de notificação de um usuário. N do mesmo `kind` são permitidos.
///
/// `config` CARREGA SEGREDO — a URL de um webhook do Slack É a credencial de
/// escrita naquele canal. Nunca vai crua na resposta da API nem em log.
model UserNotificationTarget {
  id         String                  @id @default(uuid())
  /// Denormalizado p/ RLS. A tabela fica DENTRO do RLS, como `Subscription`:
  /// só é tocada em rota autenticada (ver a nota da migration).
  ownerId    String
  userId     String
  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       NotificationChannelKind
  /// Rótulo dado pelo usuário ("Meu e-mail", "n8n de casa").
  label      String
  /// IN_APP: `{}`. EMAIL: `{ "email": "…" }`. Os demais (WEBHOOK, SLACK, DISCORD,
  /// TELEGRAM): `{ "url": "https://…" }` — no TELEGRAM a URL já carrega o token no
  /// path e o `chat_id` na query, montada pelo front.
  config     Json
  /// Opt-in: quais tipos este destino recebe. Vazio = nenhum. Mesmo desenho de
  /// `Role.permissions` (String[] no próprio registro), e é o que faz a matriz
  /// de preferências ser tipo × DESTINO, não tipo × kind.
  types      NotificationType[]      @default([])
  /// Os destinos de integração só entregam depois de verificados (D4).
  /// IN_APP/EMAIL nascem true.
  verified   Boolean                 @default(false)
  active     Boolean                 @default(true)
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  deliveries NotificationDelivery[]

  @@index([ownerId, userId])
}

// --- webhook de saída do owner (Fase 19-B) ---------------------------------
//
// É a fronteira OPOSTA à do `UserNotificationTarget`, e a distinção precisa
// continuar escrita (aviso do plano da Fase 9): aquele é destino **do usuário**
// (o Slack pessoal, o n8n de casa) e carrega a preferência de quem recebe
// notificação; este é webhook **da workspace**, que o owner cadastra para os
// eventos de negócio saírem para um sistema de terceiro. Reusar
// `NotificationDelivery` para os dois acoplaria duas features que o roadmap
// manda não confundir.

/// Endereço da workspace que recebe evento de negócio.
model OwnerWebhook {
  id         String                 @id @default(uuid())
  ownerId    String
  owner      User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Nome dado por quem cadastrou ("n8n de faturamento", "Zapier do comercial").
  name       String
  url        String
  /// Segredo HMAC, **em claro**. Não é descuido: HMAC é simétrico, e assinar
  /// exige o segredo em claro no momento do envio — hash é impossível por
  /// construção. É consistente com `UserNotificationTarget.config`, que já
  /// guarda a URL do Slack, que É credencial de escrita. (O segredo TOTP é
  /// diferente e CIFRA, porque comprometê-lo é tomada de conta.)
  ///
  /// Nunca sai na resposta da API: `paraApi` devolve só o host da URL, e o
  /// segredo aparece uma única vez, na criação e na rotação.
  secret     String
  /// Opt-in: quais eventos este webhook recebe. Vazio = nenhum. Mesmo desenho de
  /// `Role.permissions` e `UserNotificationTarget.types` — String[] no próprio
  /// registro. Os valores são as chaves de `domain/owner-webhook-event.ts`, que
  /// é **contrato público**: renomear um item quebra integração de terceiro.
  events     String[]               @default([])
  /// Nasce `false` e só entrega depois do ping de verificação, como o destino de
  /// integração da Fase 9: cadastrar um endereço que o CRM nunca alcançou
  /// produziria só entregas falhas.
  active     Boolean                @default(false)
  verifiedAt DateTime?
  /// Última entrega BEM-SUCEDIDA. Responde "este webhook ainda está vivo?".
  lastUsedAt DateTime?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  deliveries OwnerWebhookDelivery[]

  @@unique([ownerId, name])
  @@index([ownerId])
}

/// A linha do outbox do webhook do owner. Tabela própria, e não
/// `NotificationDelivery`: ver a nota acima do `OwnerWebhook`.
model OwnerWebhookDelivery {
  id            String                @id @default(uuid())
  /// Denormalizado do webhook, para a policy de RLS filtrar sem JOIN. A
  /// invariante de `prisma/fixtures/invariantes.sql` afirma que ele nunca
  /// divirja do `OwnerWebhook.ownerId`.
  ownerId       String
  owner         User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  webhookId     String
  webhook       OwnerWebhook          @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  /// Chave do catálogo de eventos (`lead.recebido`, `cobranca.vencida`, …).
  event         String
  /// O corpo exato que sai no POST, montado na emissão. Guardado porque a
  /// entrega acontece DEPOIS do commit: o estado do registro pode ter mudado
  /// entre a emissão e a entrega, e o evento tem de contar o que aconteceu.
  payload       Json
  status        WebhookDeliveryStatus @default(PENDING)
  attempts      Int                   @default(0)
  nextAttemptAt DateTime              @default(now())
  /// Diagnóstico truncado em 500. **Nunca** carrega a URL nem o segredo: esta
  /// coluna é gravada no banco e pode acabar num log.
  lastError     String?
  sentAt        DateTime?
  createdAt     DateTime              @default(now())

  @@index([status, nextAttemptAt])
  @@index([ownerId, createdAt])
}

/// Própria, e não `NotificationDeliveryStatus`: `SKIPPED` (canal desligado por
/// configuração) não existe aqui — webhook inativo não gera linha nenhuma.
enum WebhookDeliveryStatus {
  PENDING
  SENT
  FAILED
}

// --- segundo fator TOTP (Fase 19-B) ----------------------------------------
//
// FORA do RLS, no grupo de `User`/`Session`/`PasswordResetToken`, e por um motivo
// mecânico: a verificação acontece no LOGIN, que é rota `@Public()` e roda sem
// `app.owner_id`. Uma policy aqui fecharia a escrita — e RLS fail-closed não
// estoura, ele grava zero linha e a rota responde sucesso. O isolamento é por
// filtro de `userId`, como em `Session`.

/// O segundo fator de UM usuário. Uma linha por pessoa (PK é o `userId`):
/// múltiplos autenticadores não são um conceito desta fase.
model UserTotp {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// O segredo TOTP, CIFRADO em AES-256-GCM (`shared/crypto/segredo-cifrado.ts`).
  /// Não é hash: TOTP é HMAC simétrico e o verificador precisa do valor em claro
  /// no momento da verificação — hash é impossível por construção, e a escolha
  /// real é cifrado vs texto puro.
  ///
  /// `keyVersion` viaja com o dado desde o dia 1 para a rotação da chave de cifra
  /// ser possível ANTES de ser necessária: sem ela, rotacionar significaria
  /// invalidar o 2FA de toda a base de uma vez.
  ciphertext String
  iv         String
  tag        String
  keyVersion Int    @default(1)

  /// Quando o titular provou que o autenticador está sincronizado.
  /// **NULL = cadastro iniciado e nunca concluído, e NÃO exige segundo fator** —
  /// é o que impede um QR que a pessoa não conseguiu ler de trancar a conta dela.
  confirmedAt DateTime?

  /// Último passo de 30s ACEITO. É a defesa de REPLAY: código já usado tem passo
  /// menor ou igual a este e é recusado. Normativo (RFC 6238 §5.2: "The verifier
  /// MUST NOT accept the second attempt of the OTP after the successful
  /// validation has been issued for the first OTP"), e **nenhuma biblioteca
  /// resolve** — o `otplib` só oferece o parâmetro `afterTimeStep` para comparar.
  ///
  /// `BigInt` porque é o número do passo (epoch/30), não um timestamp.
  lastUsedStep BigInt?

  /// Limite de tentativas por CONTA. O `@Throttle` limita por IP; isto limita a
  /// conta — que é o que a NIST SP 800-63B pede. Sucesso zera `failedAttempts`.
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?

  createdAt DateTime @default(now())
}

/// Código de recuperação de uso único. Hash sha256 e `@unique` (não argon2) pela
/// mesma razão de `PasswordResetToken.tokenHash`: o código chega SOZINHO no
/// corpo, sem identificador ao lado, então a busca tem de ser um `findUnique`
/// indexado — e não N `argon2.verify`, que a cada palpite errado custaria N
/// derivações de KDF (o vetor de DoS por exaustão de CPU que a OWASP nomeia).
///
/// A entropia é escolhida ACIMA de 112 bits justamente para o hash rápido ser
/// defensável (ASVS 6.5.2: "A standard hash function can be used if the secret
/// has 112 bits of entropy or more") — ver `totp.constants.ts`.
model UserTotpRecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  /// Consumido. O consumo é compare-and-swap (`updateMany where usedAt: null`),
  /// não check-then-act: dois usos simultâneos do mesmo código passariam.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// --- livro-razão de consentimento (Fase 19-B) -------------------------------

/// Manifestação de consentimento de um TITULAR (`Client`/`Contact`), registrada
/// pelo owner. **Append-only no banco** (`GRANT SELECT, INSERT` + `REVOKE UPDATE,
/// DELETE` para `crm_app`), no molde exato do `AuditLog`: um livro-razão que a
/// própria aplicação pode reescrever não é prova de nada — e o art. 8º § 2º põe o
/// ônus da prova do consentimento no controlador.
///
/// **Revogar é INSERIR outra linha** com `granted: false`, nunca dar `UPDATE` na
/// anterior. O art. 8º § 5º manda que a revogação preserve "ratificados os
/// tratamentos realizados sob amparo do consentimento anteriormente manifestado":
/// sobrescrever apagaria a prova de que o consentimento existiu.
///
/// **Uma linha por FINALIDADE.** Art. 8º § 4º: "as autorizações genéricas para o
/// tratamento de dados pessoais serão nulas". Um booleano de "aceitou tudo" seria
/// nulo por lei.
///
/// O que este modelo NÃO é: uma lista de opt-out de envio. O CRM não envia nada a
/// `Client`/`Contact` — todo destinatário do `MailService` é `User`. Isto é o
/// livro-razão que o owner consulta ANTES de comunicar por fora.
model ConsentRecord {
  id                String             @id @default(uuid())
  ownerId           String
  owner             User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  subjectType       ConsentSubjectType
  /// Id do `Client` ou do `Contact`. **Sem FK**, de propósito: a FK obrigaria
  /// escolher uma das duas tabelas, e a prova não pode depender de o cadastro do
  /// titular continuar existindo. A invariante de `invariantes.sql` afirma que o
  /// titular, quando existe, é do MESMO owner.
  subjectId         String
  /// Chave do catálogo de `modules/consent/domain/consent-purpose.ts`.
  purpose           String
  /// `true` = consentiu; `false` = revogou.
  granted           Boolean
  /// Versão do texto apresentado (`domain/consent-text.ts`). É o que responde "a
  /// QUE ele consentiu" — art. 9º § 1º e art. 8º § 6º.
  textVersion       String
  /// Como se manifestou: "formulario-site", "whatsapp", "telefone", "presencial".
  channel           String
  /// Evidência livre: id do envio do formulário, print, número de protocolo.
  evidence          String?
  /// Prazo de retenção INFORMADO ao titular. O guia da ANPD é explícito: a
  /// ausência dessa informação viola a exigência de consentimento informado.
  informedRetention String?
  /// Quem registrou. **Sem FK**: apagar o colaborador não pode apagar a prova —
  /// mesma decisão de `AuditLog.actorId`, e o nome fica denormalizado ao lado.
  recordedByUserId  String?
  recordedByName    String
  /// Quando o TITULAR se manifestou — que pode ser antes de alguém digitar.
  occurredAt        DateTime
  createdAt         DateTime           @default(now())

  @@index([ownerId, subjectType, subjectId, purpose, occurredAt])
  @@index([ownerId, createdAt])
}

enum ConsentSubjectType {
  CLIENT
  CONTACT
}
